[node name="Liesbeth" type="Node" parent="Quests/II_2-The Rumor Mill/obj1-init-Reactions"]
script = ExtResource("26_message")
_text = "Toverij die je niet eens ziet... Onzichtbare magie, dat is het!"
_character = ExtResource("42_liesbethdata")

[node name="MsBram" type="Node" parent="Quests/II_2-The Rumor Mill/obj1-init-Reactions"]
script = ExtResource("26_message")
_text = "Een wonderkind, hier in ons eigen Beaverford. En ik had haar nog in mijn klas!"
_character = ExtResource("43_msbramdata")

[node name="obj2-init-Requests" type="Node" parent="Quests/II_2-The Rumor Mill"]
script = ExtResource("21_listener")
_checkObjectiveId = true
_objectiveId = "fff66ceb-01f6-41ab-8d61-552129f73b02"
_checkState = true
_state = 1
_resumeAfterLoad = true
eventChannel = ExtResource("34_channel")

[node name="Hendrik" type="Node" parent="Quests/II_2-The Rumor Mill/obj2-init-Requests"]
script = ExtResource("26_message")
_text = "Mabel, mijn molensteen draait veel te snel. Het meel komt er als gruis uit. Kom je kijken bij de molen?"
_character = ExtResource("41_hendrikdata")

[node name="Liesbeth" type="Node" parent="Quests/II_2-The Rumor Mill/obj2-init-Requests"]
script = ExtResource("26_message")
_text = "En mijn betoverde weegschaal klopt niet meer! Mijn broden mislukken. Kom je naar de bakkerij?"
_character = ExtResource("42_liesbethdata")

[node name="MsBram" type="Node" parent="Quests/II_2-The Rumor Mill/obj2-init-Requests"]
script = ExtResource("26_message")
