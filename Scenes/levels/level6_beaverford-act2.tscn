[sub_resource type="Resource" id="Resource_ii3h_challenge"]
script = ExtResource("28_challenge")
Name = "Hendriks molen (II.3)"
Formula = "a * b - c"
Params = Array[ExtResource("29_param")]([SubResource("Resource_ii3h_a"), SubResource("Resource_ii3h_b"), SubResource("Resource_ii3h_c")])
Constraints = PackedStringArray("answer > 0")
Visualization = SubResource("Resource_ii3h_vis")
Input = SubResource("Resource_ii3h_input")
QuestionText = "Het tandwielrad van de molen rekent uit hoe snel de molensteen moet draaien.
Lees de ringen van buiten naar binnen.
Hoeveel toeren per minuut moet de molensteen draaien?"
HintText = "Vermenigvuldigen gaat voor optellen en aftrekken. Reken dus eerst de × uit."

