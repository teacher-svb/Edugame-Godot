[sub_resource type="Resource" id="Resource_ii1_challenge"]
script = ExtResource("28_challenge")
Name = "Cornelis' brug (II.1)"
Formula = "b + s - c"
Params = Array[ExtResource("29_param")]([SubResource("Resource_ii1_b"), SubResource("Resource_ii1_s"), SubResource("Resource_ii1_c")])
Constraints = PackedStringArray("answer > 0")
Visualization = SubResource("Resource_ii1_vis")
Input = SubResource("Resource_ii1_input")
QuestionText = "De brug weegt {b} kg en Cornelis' voorraad op de brug weegt {s} kg.
In de bak van het tegengewicht ligt {c} kg.
Hoeveel kg moet er nog bij in de bak om de brug in evenwicht te brengen?"
HintText = "Tel eerst de brug en de voorraad op. Trek daarna af wat er al in de bak ligt."

