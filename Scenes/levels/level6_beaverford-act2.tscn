[sub_resource type="Resource" id="Resource_ii3l_challenge"]
script = ExtResource("28_challenge")
Name = "Liesbeths weegschaal (II.3)"
Formula = "a * b - c"
Params = Array[ExtResource("29_param")]([SubResource("Resource_ii3l_a"), SubResource("Resource_ii3l_b"), SubResource("Resource_ii3l_c")])
Constraints = PackedStringArray("answer > 0")
Visualization = SubResource("Resource_ii3l_vis")
Input = SubResource("Resource_ii3l_input")
QuestionText = "Volgens het recept gaat er {a} g meel in één brood.
Liesbeth moet vanavond {b} broden bakken.
Er ligt al {c} g meel op de schaal.
Hoeveel gram meel moet er nog bij?"
HintText = "Reken eerst uit hoeveel meel alle broden samen nodig hebben. Trek daarna af wat er al op de schaal ligt."

