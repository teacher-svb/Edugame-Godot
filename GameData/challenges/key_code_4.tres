[resource]
script = ExtResource("2_math")
Name = "Sleutelcode"
Formula = "a * 1000 + b * 100 + c * 10 + d"
Params = Array[ExtResource("1_spec")]([SubResource("Spec_a"), SubResource("Spec_b"), SubResource("Spec_c"), SubResource("Spec_d")])
Unknowns = PackedStringArray("a", "b", "c", "d")
Visualization = SubResource("Vis_key")
QuestionText = "De deur zit op slot. Snij de sleutel: elke tand is een cijfer van het getal (D = duizendtallen, H = honderdtallen, T = tientallen, E = eenheden). Het getal staat ergens in deze kamer."
