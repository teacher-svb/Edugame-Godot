[sub_resource type="Resource" id="Objective_reach"]
script = ExtResource("1_obj")
_startText = "Vallende stenen! Ik moet goed kijken waar de grond nog stevig is."
_completeText = "Gehaald, zonder een schram! Daar staat de aardtovenaar."
_characterData = ExtResource("2_mabel")
_objectiveId = "3245c0e2-f9e0-4ffe-9b3f-fbffa9dd9801"
metadata/_custom_type_script = "uid://bkc5aqh43okjh"

[sub_resource type="Resource" id="Objective_spark"]
script = ExtResource("1_obj")
_startText = "De laatste proef. Stap op het platform, kind, en laat de aarde voelen wat je kunt."
_completeText = "Niets. De aarde voelt helemaal niets."
_characterData = ExtResource("3_wizard")
_objectiveId = "3245c0e2-f9e0-4ffe-9b3f-fbffa9dd9802"
metadata/_custom_type_script = "uid://bkc5aqh43okjh"

[sub_resource type="Resource" id="Objective_onwards"]
script = ExtResource("1_obj")
_startText = "Er zit geen mana in je, Mabel. Zonder mana word je geen tovenaar. Je bent niet toegelaten."
_completeText = "Ga maar naar huis. De poort brengt je naar het bos."
_characterData = ExtResource("3_wizard")
_objectiveId = "3245c0e2-f9e0-4ffe-9b3f-fbffa9dd9803"
metadata/_custom_type_script = "uid://bkc5aqh43okjh"

