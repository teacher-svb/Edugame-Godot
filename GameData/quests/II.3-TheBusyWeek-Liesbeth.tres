[sub_resource type="Resource" id="Resource_obj1"]
script = ExtResource("1_obj")
_startText = "Mabel, daar ben je! Kom gauw binnen. Mijn betoverde weegschaal geeft maar wat aan, en vanavond wil het hele dorp brood."
_completeText = "Kijk: het recept, de broden die ik moet bakken, en het meel dat al op de schaal ligt. Maar hoeveel moet er nog bij?"
_characterData = ExtResource("2_liesbeth")
_objectiveId = "13a54ec8-e70e-42c3-b25b-6a35c8d9a901"
metadata/_custom_type_script = "uid://bkc5aqh43okjh"

[sub_resource type="Resource" id="Resource_obj2"]
script = ExtResource("1_obj")
_startText = "Eens kijken... Zoveel meel per brood, zoveel broden, en er ligt al wat op de schaal."
_failText = "Hmm, dat klopt nog niet. Ik reken het nog eens na."
_completeText = "Dat is het! Zoveel meel moet er nog bij."
_characterData = ExtResource("3_mabel")
_objectiveId = "13a54ec8-e70e-42c3-b25b-6a35c8d9a902"
metadata/_custom_type_script = "uid://bkc5aqh43okjh"

[sub_resource type="Resource" id="Resource_obj3"]
script = ExtResource("1_obj")
_startText = "Je schept het erbij en... kijk! De schalen hangen weer in evenwicht!"
_completeText = "Vanavond ruikt heel Beaverford weer naar vers brood. Dank je wel, Mabel!"
_characterData = ExtResource("2_liesbeth")
_objectiveId = "13a54ec8-e70e-42c3-b25b-6a35c8d9a903"
metadata/_custom_type_script = "uid://bkc5aqh43okjh"

[resource]
script = ExtResource("4_quest")
