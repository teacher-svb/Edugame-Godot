[sub_resource type="Resource" id="Objective_reach"]
script = ExtResource("1_obj")
_startText = "Vlammen! De tovenaar wacht aan de overkant. Ik moet precies op het goede moment tussen het vuur door."
_completeText = "Gehaald! Daar staat de vuurtovenaar."
_characterData = ExtResource("2_mabel")
_objectiveId = "76aea55d-b75f-46d0-a036-841e8309a201"
metadata/_custom_type_script = "uid://bkc5aqh43okjh"

[sub_resource type="Resource" id="Objective_spark"]
script = ExtResource("1_obj")
_startText = "Zo, jij bent Mabel. Stap op het platform voor de Vonkproef, dan zien we of er vuur in je zit."
_completeText = "Hm. Geen vonk. Niet eens een rookpluimpje."
_characterData = ExtResource("3_fire")
_objectiveId = "76aea55d-b75f-46d0-a036-841e8309a202"
metadata/_custom_type_script = "uid://bkc5aqh43okjh"

[sub_resource type="Resource" id="Objective_onwards"]
script = ExtResource("1_obj")
_startText = "Vuur is niet jouw element, kind. Probeer het maar bij de watertovenaar."
_completeText = "De poort achter mij staat open. Ga maar."
_characterData = ExtResource("3_fire")
_objectiveId = "76aea55d-b75f-46d0-a036-841e8309a203"
metadata/_custom_type_script = "uid://bkc5aqh43okjh"

