[sub_resource type="Resource" id="Resource_obj2"]
script = ExtResource("1_obj")
_startText = "Wie schrijft mij nu een brief? Ik maak hem open."
_failText = ""
_completeText = "Een gilde van ingenieurs, die zonder toverij dingen maken... net als ik. Vannacht dus. Bij de put, na twaalf slagen van de schoolbel."
_characterData = ExtResource("2_mabel")
_objectiveId = "3c2415fe-208a-4dd5-928f-903a8aeb0802"
