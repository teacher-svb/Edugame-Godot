[sub_resource type="Resource" id="Resource_obj1"]
script = ExtResource("1_obj")
_startText = "Thuis. Hè? Wat ligt daar op tafel?"
_failText = ""
_completeText = "Een brief. Voor mij? Met een zegel in de vorm van een tandwiel..."
_characterData = ExtResource("2_mabel")
