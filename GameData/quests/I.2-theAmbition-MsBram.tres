[sub_resource type="Resource" id="Resource_3lbet"]
script = ExtResource("1_br8sl")
_startText = "De schoolbel is stuk! De klepel raakt de bel niet meer op het juiste moment."
_progressText = "Sta daar niet zomaar, kindje, kijk eens naar het mechaniek."
_completeText = "Kan jij uitvissen hoe de klepel weer op tijd moet slaan?"
_characterData = ExtResource("2_bram1")
