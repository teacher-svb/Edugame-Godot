[sub_resource type="Resource" id="Resource_ayd0y"]
script = ExtResource("1_br8sl")
_startText = "Knap gerekend, Mabel, maar ik kan de bel niet zomaar laten herstellen door een leerling."
_progressText = "Ik meen het — dit is werk voor een echte tovenaar."
_completeText = "Als je zo graag mensen wil helpen, waarom schrijf je je dan niet in bij de Tovenaarsschool?"
_characterData = ExtResource("2_bram1")
_objectiveId = "3a861b47-c25e-4265-8205-81e4394e3903"
