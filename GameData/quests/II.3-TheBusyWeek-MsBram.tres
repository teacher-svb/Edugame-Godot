[sub_resource type="Resource" id="Resource_obj1"]
script = ExtResource("1_obj")
_startText = "Mabel, gelukkig! Hoor je dat? De bel luidt wanneer ze zelf wil. De kinderen weten niet meer wanneer de les begint."
_completeText = "Hier hangt het lesrooster: de tijden van de bel, in minuten na acht uur. Maar de laatste bel is uitgeveegd."
_characterData = ExtResource("2_msbram")
_objectiveId = "5db5ba3b-7f5e-4770-85b6-3070aff45901"
metadata/_custom_type_script = "uid://bkc5aqh43okjh"

[sub_resource type="Resource" id="Resource_obj2"]
script = ExtResource("1_obj")
_startText = "Eens kijken... De eerste bel, en dan telkens even lang tot de volgende."
_failText = "Hmm, dat klopt nog niet. Ik reken het nog eens na."
_completeText = "Dat is het! Dan moet de laatste bel gaan."
_characterData = ExtResource("3_mabel")
_objectiveId = "5db5ba3b-7f5e-4770-85b6-3070aff45902"
metadata/_custom_type_script = "uid://bkc5aqh43okjh"

[sub_resource type="Resource" id="Resource_obj3"]
script = ExtResource("1_obj")
_startText = "Je stelt de klepel bij en... ding, dong! Precies op tijd."
_completeText = "De lessen kunnen weer op tijd beginnen. Dank je wel, Mabel!"
_characterData = ExtResource("2_msbram")
_objectiveId = "5db5ba3b-7f5e-4770-85b6-3070aff45903"
metadata/_custom_type_script = "uid://bkc5aqh43okjh"

[resource]
script = ExtResource("4_quest")
_id = "5db5ba3b-7f5e-4770-85b6-3070aff45900"
_name = "The Busy Week: Mevrouw Bram"
_objectives = Array[ExtResource("1_obj")]([SubResource("Resource_obj1"), SubResource("Resource_obj2"), SubResource("Resource_obj3")])
