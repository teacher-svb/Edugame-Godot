[sub_resource type="Resource" id="Resource_obj1"]
script = ExtResource("1_obj")
_startText = "Mabel! MABEL! Hierzo, aan de overkant! Mijn ophaalbrug zit al dagen vast en ik kan er niet meer af!"
_failText = "Loop niet weg! Alsjeblieft, kom naar de gracht!"
_completeText = "Ik weet dat ik je weggestuurd heb... maar de tovenaar komt niet en mijn eten is op. Kun jij er nog eens naar kijken?"
_characterData = ExtResource("2_cornelis")
_objectiveId = "daaeb60f-a9fb-4892-9e1a-d7390bcd1c01"
metadata/_custom_type_script = "uid://bkc5aqh43okjh"

[sub_resource type="Resource" id="Resource_obj2"]
script = ExtResource("1_obj")
_startText = "Eens kijken... De brug, de voorraad op de brug, en de bak met het tegengewicht."
_failText = "Hmm, dat klopt nog niet. Ik reken het nog eens na."
_completeText = "Dat is het! Zoveel moet er bij in de bak."
_characterData = ExtResource("3_mabel")
_objectiveId = "daaeb60f-a9fb-4892-9e1a-d7390bcd1c02"
metadata/_custom_type_script = "uid://bkc5aqh43okjh"

[sub_resource type="Resource" id="Resource_obj3"]
script = ExtResource("1_obj")
_startText = "Wat doe je nu met die bak? Hé... hé! Er beweegt iets!"
_completeText = "Wacht maar tot de anderen dit horen!"
_characterData = ExtResource("2_cornelis")
_objectiveId = "daaeb60f-a9fb-4892-9e1a-d7390bcd1c03"
metadata/_custom_type_script = "uid://bkc5aqh43okjh"

[resource]
script = ExtResource("4_quest")
_id = "daaeb60f-a9fb-4892-9e1a-d7390bcd1c00"
_name = "The Desperate Help: Cornelis"
_objectives = Array[ExtResource("1_obj")]([SubResource("Resource_obj1"), SubResource("Resource_obj2"), SubResource("Resource_obj3")])
