[sub_resource type="Resource" id="Objective_forest"]
script = ExtResource("1_obj")
_startText = "Geen mana. Geen tovenaar. Dan ga ik maar naar huis, door het bos."
_completeText = "Daarboven, tussen de rotsen: de manabron. Alle magie komt daarvandaan... maar voor mij is er niets."
_characterData = ExtResource("2_mabel")
_objectiveId = "0402a3f0-34b9-41f6-9ed7-7756703a1801"
metadata/_custom_type_script = "uid://bkc5aqh43okjh"

[sub_resource type="Resource" id="Objective_home"]
script = ExtResource("1_obj")
_startText = "Kom op, Mabel. Naar huis."
_completeText = "Thuis. En nu? Ik ben geen tovenaar, en dat word ik ook nooit."
_characterData = ExtResource("2_mabel")
_objectiveId = "0402a3f0-34b9-41f6-9ed7-7756703a1802"
metadata/_custom_type_script = "uid://bkc5aqh43okjh"

