[sub_resource type="Resource" id="Objective_spark"]
script = ExtResource("1_obj")
_startText = "Ah, de leerling van het vuur. Stap op het platform. Misschien stroomt er water door je heen."
_failText = ""
_completeText = "Niets. Geen druppel, niet eens een beetje mist."
_characterData = ExtResource("3_wizard")
_objectiveId = "ea871cbc-3987-48ad-892e-8f56e553d102"
metadata/_custom_type_script = "uid://bkc5aqh43okjh"

[sub_resource type="Resource" id="Objective_onwards"]
script = ExtResource("1_obj")
_startText = "Water is ook niet jouw element. Ga maar naar de aardtovenaar."
_failText = ""
_completeText = "De poort achter mij staat open. Ga maar."
_characterData = ExtResource("3_wizard")
_objectiveId = "ea871cbc-3987-48ad-892e-8f56e553d103"
