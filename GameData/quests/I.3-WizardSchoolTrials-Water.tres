[sub_resource type="Resource" id="Objective_reach"]
script = ExtResource("1_obj")
_startText = "Water! Het stroomt overal. Ik moet op het goede moment van vlot naar vlot springen."
_failText = ""
_completeText = "Droog aangekomen! Daar staat de watertovenaar."
_characterData = ExtResource("2_mabel")
_objectiveId = "ea871cbc-3987-48ad-892e-8f56e553d101"
