[sub_resource type="Resource" id="Resource_obj1"]
script = ExtResource("1_obj")
_startText = "Daar is ze! Mensen, luister! Mabel heeft mijn ophaalbrug gemaakt. Zonder toverstaf! Zonder één spreuk!"
_completeText = "Lang leve Mabel, het wonderkind van Beaverford!"
_characterData = ExtResource("2_cornelis")
_objectiveId = "fff66ceb-01f6-41ab-8d61-552129f73b01"
metadata/_custom_type_script = "uid://bkc5aqh43okjh"

[sub_resource type="Resource" id="Resource_obj2"]
script = ExtResource("1_obj")
_startText = "Maar... het was geen toverij. Ik heb gewoon gerekend."
_completeText = "Goed dan. Eén voor één. Eerst maar eens gaan kijken!"
_characterData = ExtResource("3_mabel")
_objectiveId = "fff66ceb-01f6-41ab-8d61-552129f73b02"
metadata/_custom_type_script = "uid://bkc5aqh43okjh"

[resource]
