[sub_resource type="Resource" id="Resource_ifhgx"]
script = ExtResource("1_hd8sl")
_startText = "Ach, vroeger draaide alles vanzelf goed, zonder rekenwerk of kinderstreken."
_failText = "Ga nu maar, ik heb geen tijd voor spelletjes."
_completeText = "Voor een echt probleem heb je echte magie nodig, geen sommetjes."
