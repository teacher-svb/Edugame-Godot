[sub_resource type="Resource" id="Resource_vh82f"]
script = ExtResource("1_hd8sl")
_startText = "M'n molen draait niet meer zoals het hoort! De molensteen loopt veel te traag."
_failText = "Nou, sta daar niet zo besluiteloos! Kijk dan naar dat rad!"
_completeText = "Denk je dat jij kan uitvissen wat er mis is met de snelheid?"
