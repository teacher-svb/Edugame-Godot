[sub_resource type="Resource" id="Resource_obj1"]
script = ExtResource("1_obj")
_startText = "Daar ben je, Mabel. Hoor je dat? De molensteen raast maar door, en mijn meel komt eruit als gruis."
_failText = ""
_completeText = "Het tandwielrad bepaalt hoe snel de steen draait. Maar al die getallen erop... daar word ik duizelig van."
_characterData = ExtResource("2_hendrik")
_objectiveId = "bda3574b-3ad5-4852-82a9-86818f51d501"
metadata/_custom_type_script = "uid://bkc5aqh43okjh"

[sub_resource type="Resource" id="Resource_obj2"]
script = ExtResource("1_obj")
_startText = "Eens kijken... De wieken, de tandwielen en de slip. Ik lees het rad van buiten naar binnen."
_failText = "Hmm, dat klopt nog niet. Ik reken het nog eens na."
_completeText = "Dat is het! Zo snel moet de molensteen draaien."
_characterData = ExtResource("3_mabel")
_objectiveId = "bda3574b-3ad5-4852-82a9-86818f51d502"
metadata/_custom_type_script = "uid://bkc5aqh43okjh"

[sub_resource type="Resource" id="Resource_obj3"]
script = ExtResource("1_obj")
_startText = "Je zet het rad goed en... hoor! De steen maalt weer rustig."
_failText = ""
_completeText = "Fijn meel, zoals het hoort. Dank je wel, Mabel!"
_characterData = ExtResource("2_hendrik")
_objectiveId = "bda3574b-3ad5-4852-82a9-86818f51d503"
metadata/_custom_type_script = "uid://bkc5aqh43okjh"

[resource]
