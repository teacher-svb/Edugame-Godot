 "sockets": {
  "room": "floor continues into the next tile (inside a room)",
  "wall+": "a wall or curb of a room or landing; fits only a chasm side wall-",
  "gate+": "a gate (2 m opening) of a room or landing; fits only a bridge end gate-",
  "gate-": "a bridge end; fits only gate+",
  "flank+": "the side of a bridge; fits only a chasm side flank-",
  "void": "chasm to chasm, the door side of the door / stairs tiles, and the map boundary"
 },
 "socket_rule": "Plain labels fit the same label; x+ fits x- only. So rooms never touch wall to wall, rooms only connect over bridges, and bridges have chasm on both sides; a crossing longer than one cell goes bridge - landing - bridge. WFC fields: N = SocketNegZ, E = SocketPosX, S = SocketPosZ, W = SocketNegX; up and down \"ground\". Map boundary: void.",
 "room_codes": "room_<NESW> / landing_<NESW>: o = room (open), w = wall (edge), g = gate.",
 "platforming": {
  "player": "tuned for jump velocity 3 m/s, speed 3 m/s, default gravity: about 0.46 m high and 1.8 m far",
  "broken": "gap 1.15 m (west half) and 1.25 m (east half) of the N-S build, deck at 0",
  "stones": "one stepping stone, top at +0.3 m, 1.0 m from each ledge",
  "steps": "middle 1.6 m of the deck raised to +0.3 m",
  "mover": "ledges 0.4 m at both ends, 3.2 m gap; the moving platform (school_moving_platform.glb, 1.4 x 1.4 m, top at 0) travels along the tile axis between the ledges: centre from -0.9 m to +0.9 m from the tile centre",
  "heights_m": {
   "step": 0.3,
   "wall": 1.0,
   "curb": 0.45,
   "invisible_barrier": 0.95,
   "abyss": -6.0
  }
 },
