{
 "tile_size_m": 4.0,
 "axes": "Godot: tile centre at the node origin, x east (+X), north = -Z. Place tile (col, row) at (col * 4 + 2, 0, row * 4 + 2) with row 0 in the north. One MeshLibrary item per shape, built in its base orientation (the sockets and scatter mask below) and turned in the GridMap: every tile is Rotation FourWay. Rotate cells around Y only, never mirror.",
 "gridmap_turns": {
  "note": "Quarter turns around +Y as godoowave counts them (counter-clockwise seen from above): the base north side ends up facing the side named here. GridMap cell orientation index per turn.",
  "north": {
   "turns": 0,
   "orientation": 0
  },
  "west": {
   "turns": 1,
   "orientation": 16
  },
  "south": {
   "turns": 2,
   "orientation": 10
  },
  "east": {
   "turns": 3,
   "orientation": 22
  }
 },
 "replaces": "Per tile: the tiles of the old one-file-per-rotation set it replaces, with the GridMap orientation index that gives the same tile (e.g. path_curve_ES = path_curve_NE at orientation 22). Use it to remap GridMaps painted with the old set.",
 "floor_height": "Forest floor at y = 0 on every tile edge (gentle bumps inside a tile), paths 0.08 m lower, border bank 0.5 m higher.",
 "socket_rule": "godoowave: equal symmetric labels fit (FF, FFP, BB, BBP); a one-sided label fits its partner (FB+ against FB-).",
 "socket_labels": {
  "FF": "forest floor along the whole edge",
  "FFP": "forest floor with a 2 m path in the middle of the edge",
  "BB": "border (raised forest-edge bank) along the whole edge",
  "BBP": "border with a path through it (the way into or out of the level)",
  "FB+": "half floor, half border: floor first, reading the edge clockwise around the tile",
  "FB-": "half floor, half border: border first, reading the edge clockwise around the tile"
 },
 "socket_reading": "Edges are read clockwise around the tile seen from above (north edge west -> east, east edge north -> south, south edge east -> west, west edge south -> north). That reading survives any turn of the tile, and two neighbours read their shared edge in opposite directions, so FB+ meets FB-.",
 "map_edge": "Use \"BB\" for cells outside the map to close the level with border; to make a way out, give that outside edge \"BBP\" (only border_exit and border_path tiles have it).",
 "scatter_mask": "16 x 16 cells of 0.25 m per tile in its base orientation, rows north -> south (Godot -Z -> +Z), columns west -> east: 0 = keep clear (path and 0.6 m beside it), 1 = forest floor, 2 = border bank (dense). For a turned cell, turn the lookup point back with the inverse of the cell basis first.",
